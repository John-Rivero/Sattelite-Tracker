                    <property name="styleSheet">
                     <string notr="true">QPushButton {
    background-color: #3B82F6;              /* Electric accent blue */
    color: #FFFFFF;                         /* Crisp white text */
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    padding: 9px 18px;
}

QPushButton:hover {
    background-color: #2563EB;              /* Darker blue on hover */
}

QPushButton:pressed {
    background-color: #1D4ED8;              /* Deep blue click feedback */
    padding-top: 10px;                      /* Tactile micro-offset */
    padding-bottom: 8px;
}

QPushButton:disabled {
    background-color: #4A5568;              /* Slate muted disabled */
    color: #A0AEC0;
}</string>
