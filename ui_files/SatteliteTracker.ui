                <widget class="QTableView" name="tableView">
                 <property name="styleSheet">
                  <string notr="true">/* Table Base &amp; Canvas */
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;       /* Subtle zebra striping */
    color: #0F172A;                            /* Deep slate text */
    font-family: 'Segoe UI', system-ui, sans-serif;
    font-size: 13px;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    gridline-color: #F1F5F9;                   /* Ultra-light horizontal dividers */
    selection-background-color: #EFF6FF;       /* Soft tint highlight on selected row */
    selection-color: #1E40AF;                  /* Strong blue text on selection */
    outline: none;                             /* Removes dotted focus rectangle */
}

/* Cell Selection / Focus */
QTableView::item {
    padding: 8px 12px;                         /* Breathing room for cell text */
    border: none;
}

QTableView::item:hover {
    background-color: #F1F5F9;                 /* Light hover highlight */
}

QTableView::item:selected {
    background-color: #DBEAFE;                 /* Clear row selection tone */
    color: #1E3A8A;
    font-weight: 600;
}

/* Header Columns */
QHeaderView::section {
    background-color: #F8FAFC;                 /* Elevated header background */
    color: #475569;                            /* Slate gray column titles */
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    border: none;
    border-bottom: 2px solid #E2E8F0;          /* Clean header underline */
    border-right: 1px solid #F1F5F9;
    padding: 10px 12px;
}

/* Vertical Row Numbers Header (Optional Hide or Mute) */
QHeaderView::section:vertical {
    background-color: #FFFFFF;
    color: #94A3B8;
    border-right: 1px solid #E2E8F0;
    border-bottom: none;
    padding: 0px 8px;
}

/* Corner Widget (Intersection of Row &amp; Column Headers) */
QTableCornerButton::section {
    background-color: #F8FAFC;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    border-right: 1px solid #E2E8F0;
}

/* Minimalist Modern Scrollbars */
QTableView QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 2px 4px 0px;
}

QTableView QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 25px;
    border-radius: 3px;
}

QTableView QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QTableView QScrollBar::add-line:vertical,
QTableView QScrollBar::sub-line:vertical,
QTableView QScrollBar::add-page:vertical,
QTableView QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0px;
}

QTableView QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px 4px 2px 4px;
}

QTableView QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 25px;
    border-radius: 3px;
}

QTableView QScrollBar::add-line:horizontal,
QTableView QScrollBar::sub-line:horizontal {
    background: none;
    border: none;
    width: 0px;
}</string>
                 </property>
