                    <property name="styleSheet">
                     <string notr="true">/* Crisp Light SaaS */
QTextBrowser {
    background-color: #F8FAFC;              /* Clean off-white surface */
    color: #0F172A;                         /* Deep contrast charcoal text */
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    font-size: 13px;
    border: 1px solid #CBD5E1;              /* Subtle neutral boundary */
    border-radius: 8px;
    padding: 12px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

/* Scrollbar */
QTextBrowser QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 2px 4px 0px;
}

QTextBrowser QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 25px;
    border-radius: 3px;
}

QTextBrowser QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QTextBrowser QScrollBar::add-line:vertical,
QTextBrowser QScrollBar::sub-line:vertical,
QTextBrowser QScrollBar::add-page:vertical,
QTextBrowser QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0px;
}</string>
